  progressPercentage Float       @default(0)
  learningStatus     String      @default("NOT_STARTED") // NOT_STARTED, ACTIVE, ON_TRACK, NEEDS_ATTENTION, SUPPORT_RECOMMENDED, COMPLETED
  engagementLevel    String      @default("MEDIUM")      // LOW, MEDIUM, HIGH
  performanceTrend   String      @default("STABLE")      // IMPROVING, STABLE, DECLINING
  lastActivityAt     DateTime    @default(now())

  strengthSummary    Json?
  improvementSummary Json?

  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([learningStatus])
