model FlashcardDeck {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  cards          Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// INTELLIGENCE CORE MODELS  (Waves 1–4 additions — additive only)
// ─────────────────────────────────────────────────────────────────────────────

// Wave 1 — Recommendation feedback loop
model RecommendationResult {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendationType  String   // course, lesson, skill, career
  targetId            String?  // courseId or skill name
  targetTitle         String
  reason              String
  score               Float    @default(0)
  wasActedOn          Boolean  @default(false)
  actionType          String?  // enrolled, viewed, dismissed
  actedAt             DateTime?
  createdAt           DateTime @default(now())

  @@index([userId])
  @@index([recommendationType])
  @@index([createdAt])
}

// Wave 2 — Per-question quiz attempt history (enables weak-topic detection)
model QuizAttempt {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId         String
  lessonId         String?
  quizId           String?
  questionIndex    Int
  question         String
  selectedAnswer   String
  correctAnswer    String
  isCorrect        Boolean
  topic            String?  // extracted topic tag for weakness detection
  timeSpentSeconds Int      @default(0)
  attemptNumber    Int      @default(1)
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([courseId])
  @@index([userId, courseId])
}

// Wave 3 — Learning session time-on-task tracking
model LearningSession {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String?
  lessonId        String?
  startedAt       DateTime @default(now())
  endedAt         DateTime?
  durationSeconds Int      @default(0)
  deviceType      String?
  pageContext     String?  // lesson, quiz, mentor, course-overview
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([courseId])
  @@index([userId, courseId])
}

// Wave 4 — Analytics engine output / at-risk scoring
model LearnerAnalyticsReport {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  riskLevel           String   @default("low")   // low, medium, high, critical
  riskFactors         Json?
  engagementScore     Float    @default(0)
  consistencyScore    Float    @default(0)
  momentumScore       Float    @default(0)
  predictedCompletion Json?    // { courseId, predictedDays, confidence }[]
  atRiskSince         DateTime?
  generatedAt         DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([riskLevel])
  @@index([generatedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Unified Learning Event Pipeline
// ─────────────────────────────────────────────────────────────────────────────

model LearningEvent {
  id              String   @id @default(uuid())
  idempotencyKey  String?  @unique
  userId          String
  user            User     @relation("UserLearningEvents", fields: [userId], references: [id], onDelete: Cascade)
  eventType       String   // e.g. LESSON_STARTED, VIDEO_PROGRESS, QUIZ_COMPLETED, etc.
  courseId        String?
  sectionId       String?
  lessonId        String?
  quizId          String?
  assignmentId    String?
  timestamp       DateTime @default(now())
  duration        Float?   // duration in seconds
  score           Float?   // assessment score
  progress        Float?   // percentage (0 - 100)
  metadata        Json?    // custom attributes (sanitized, non-sensitive)
  context         Json?    // device, IP, user-agent, session details
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([courseId])
  @@index([lessonId])
  @@index([quizId])
  @@index([assignmentId])
  @@index([timestamp])
  @@index([userId, timestamp])
  @@index([eventType, timestamp])
  @@index([courseId, timestamp])
  @@index([userId, eventType, timestamp])
}

// ─────────────────────────────────────────────────────────────────────────────
// AI Mentor Session Audit Store
// ─────────────────────────────────────────────────────────────────────────────

model MentorSession {
  id                    String   @id @default(uuid())
  sessionId             String   @unique @default(uuid())
  userId                String
  user                  User     @relation("UserMentorSessions", fields: [userId], references: [id], onDelete: Cascade)
  courseId              String?
  lessonId              String?
  promptSummary         String
  responseSummary       String
  feedbackScore         Int?
  feedbackComment       String?
  contextVersion        String   @default("v2.1")
  sources               Json?
  suggestedNextActions  Json?
  confidenceScore       Float    @default(0.95)
  needsHumanSupport     Boolean  @default(false)
  tokenCount            Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
  @@index([courseId])
  @@index([lessonId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Hybrid Recommendation Engine Store & Next Best Action
// ─────────────────────────────────────────────────────────────────────────────

model LearnerRecommendation {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation("UserLearnerRecommendations", fields: [userId], references: [id], onDelete: Cascade)
  recommendationType  String    // NEXT_LESSON, REVISION, PRACTICE, NEXT_COURSE, LEARNING_PATH, REST_RECOVERY, INSTRUCTOR_SUPPORT
  targetType          String    // lesson, course, quiz, practice, recovery, support
  targetId            String?
  priority            String    @default("MEDIUM") // HIGH, MEDIUM, LOW
  reason              String    // Explainable recommendation reason
  evidence            Json?     // Traceable learner data
  confidence          Float     @default(0.90) // 0.0 - 1.0
  status              String    @default("PENDING") // PENDING, ACCEPTED, DISMISSED, COMPLETED
  expiresAt           DateTime?
  actedAt             DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([recommendationType])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Adaptive Learning Engine Models
// ─────────────────────────────────────────────────────────────────────────────

model AdaptiveLearningPlan {
  id                    String                   @id @default(uuid())
  userId                String
  user                  User                     @relation("UserAdaptivePlans", fields: [userId], references: [id], onDelete: Cascade)
  planType              String                   @default("BALANCED") // BALANCED, REMEDIATION, ACCELERATED
  paceMode              String                   @default("STANDARD") // SLOW_PACED, STANDARD, ACCELERATED
  suggestedSequence     Json
  summaryExplanation    String
  adaptedAt             DateTime                 @default(now())
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  recommendations       AdaptiveRecommendation[]
  milestones            MilestoneProgress[]

  @@index([userId])
  @@index([planType])
}

model AdaptiveRecommendation {
  id                    String               @id @default(uuid())
  planId                String
  plan                  AdaptiveLearningPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId                String
  user                  User                 @relation("UserAdaptiveRecommendations", fields: [userId], references: [id], onDelete: Cascade)
  category              String               // REVISION, ADVANCED_CONTENT, PRACTICE, LESSON_SEQUENCE
  title                 String
  description           String
  reason                String
  evidence              Json?
  status                String               @default("RECOMMENDED") // RECOMMENDED, ACCEPTED, DECLINED, COMPLETED
  isHelpful             Boolean?
  feedbackComment       String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([planId])
  @@index([userId])
  @@index([category])
}

model MilestoneProgress {
  id                    String               @id @default(uuid())
  planId                String
  plan                  AdaptiveLearningPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId                String
  user                  User                 @relation("UserMilestones", fields: [userId], references: [id], onDelete: Cascade)
  milestoneTitle        String
  description           String
  targetDate            DateTime?
  progress              Float                @default(0)
  completed             Boolean              @default(false)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([planId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Course Intelligence Engine Snapshot Store
// ─────────────────────────────────────────────────────────────────────────────

model CourseIntelligenceSnapshot {
  id                    String   @id @default(uuid())
  courseId              String
  course                Course   @relation("CourseSnapshots", fields: [courseId], references: [id], onDelete: Cascade)
  difficultyScore       Float    @default(50.0)
  completionRate        Float    @default(0.0)
  engagementScore       Float    @default(50.0)
  totalEnrolled         Int      @default(0)
  totalCompleted        Int      @default(0)
  dropoffPoints         Json
  weakTopicAreas        Json
  contentQualitySignals Json
  instructorInsights    Json
  drilldownData         Json?
  generatedAt           DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([courseId])
  @@index([generatedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Opportunity & Growth Intelligence Models
// ─────────────────────────────────────────────────────────────────────────────

model Opportunity {
  id                    String                   @id @default(uuid())
  title                 String
  type                  String
  organization          String
  location              String?
  description           String
  applyUrl              String?
  deadline              DateTime?
  isVerified            Boolean                  @default(true)
  status                String                   @default("active")
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  requirements          OpportunityRequirement[]
  learnerMatches        LearnerOpportunityMatch[]
  recommendations       OpportunityRecommendation[]

  @@index([type])
  @@index([status])
}

model OpportunityRequirement {
  id                    String       @id @default(uuid())
  opportunityId         String
  opportunity           Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  requirementType       String
  name                  String
  isMandatory           Boolean      @default(true)
  createdAt             DateTime     @default(now())

  @@index([opportunityId])
}

model LearnerOpportunityMatch {
  id                    String      @id @default(uuid())
  userId                String
  user                  User        @relation("UserOpportunityMatches", fields: [userId], references: [id], onDelete: Cascade)
  opportunityId         String
  opportunity           Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  matchScore            Float
  matchingReasons       Json
  missingRequirements   Json
  recommendedPreparation String
  calculatedAt          DateTime    @default(now())
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@unique([userId, opportunityId])
  @@index([userId])
  @@index([opportunityId])
}

model OpportunityRecommendation {
  id                    String      @id @default(uuid())
  userId                String
  user                  User        @relation("UserOpportunityRecommendations", fields: [userId], references: [id], onDelete: Cascade)
  opportunityId         String
  opportunity           Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  priority              String      @default("MEDIUM")
  status                String      @default("RECOMMENDED")
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([userId])
  @@index([opportunityId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Skill Evidence Ledger & Verifiable Skill Passport Models
// ─────────────────────────────────────────────────────────────────────────────

model SkillEvidence {
  id               String       @id @default(uuid())
  skillId          String
  skill            LearnerSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  userId           String
  user             User         @relation("UserSkillEvidences", fields: [userId], references: [id], onDelete: Cascade)
  evidenceType     String
  title            String
  sourceId         String?
  score            Float?
  verificationLevel String      @default("VERIFIED")
  metadata         Json?
  verifiedAt       DateTime     @default(now())
  createdAt        DateTime     @default(now())

  @@index([skillId])
  @@index([userId])
}

model SkillPassport {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation("UserSkillPassport", fields: [userId], references: [id], onDelete: Cascade)
  passportHash     String   @unique @default(uuid())
  verifiedSkillCount Int    @default(0)
  masteryIndex     Float    @default(0.0)
  shareableUrl     String?
  issuedAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([passportHash])
}

// ─────────────────────────────────────────────────────────────────────────────
// Dynamic Career Intelligence & Skill Gap Analyzer Models
// ─────────────────────────────────────────────────────────────────────────────

model CareerPath {
  id               String                @id @default(uuid())
  title            String                @unique
  category         String
  description      String
  requiredSkills   Json
  avgSalaryRange   String?
  demandLevel      String                @default("HIGH")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  learnerTargets   LearnerCareerTarget[]

  @@index([category])
}

model LearnerCareerTarget {
  id               String      @id @default(uuid())
  userId           String
  user             User        @relation("UserCareerTargets", fields: [userId], references: [id], onDelete: Cascade)
  careerPathId     String
  careerPath       CareerPath  @relation(fields: [careerPathId], references: [id], onDelete: Cascade)
  readinessScore   Float       @default(0)
  acquiredSkills   Json
  skillGaps        Json
  roadmapSteps     Json
  targetDate       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([userId, careerPathId])
  @@index([userId])
  @@index([careerPathId])
}
