// ─────────────────────────────────────────────────────────────────────────────
// Opportunity & Growth Intelligence Models
// ─────────────────────────────────────────────────────────────────────────────

model Opportunity {
  id                    String                   @id @default(uuid())
  title                 String
  type                  String                   @default("OTHER") // legacy type field
  opportunityType       String?                  @default("OTHER") // JOB | INTERNSHIP | APPRENTICESHIP | SCHOLARSHIP | FELLOWSHIP | BOOTCAMP | COMPETITION | HACKATHON | RESEARCH_OPPORTUNITY | VOLUNTEERING | PROJECT_COLLABORATION | MENTORSHIP_PROGRAM | ENTREPRENEURSHIP_PROGRAM | OTHER
  organization          String
  location              String?
  locationType          String?                  @default("REMOTE") // REMOTE | HYBRID | ON_SITE
  description           String
  applyUrl              String?
  applicationUrl        String?
  deadline              DateTime?
  publishedAt           DateTime                 @default(now())
  isVerified            Boolean                  @default(true)
  status                String                   @default("active")
  
  sourceId              String?
  source                OpportunitySource?       @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  partnerId             String?
  partner               PartnerOrganization?     @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  skillRequirements     Json?
  
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  requirements          OpportunityRequirement[]
  learnerMatches        LearnerOpportunityMatch[]
  recommendations       OpportunityRecommendation[]
  applications          OpportunityApplication[]
  interactions          OpportunityInteraction[]

  @@index([type])
  @@index([opportunityType])
  @@index([status])
  @@index([sourceId])
  @@index([partnerId])
}

model OpportunityRequirement {
  id                    String       @id @default(uuid())
  opportunityId         String
  opportunity           Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  requirementType       String
  name                  String
  isMandatory           Boolean      @default(true)
  createdAt             DateTime     @default(now())

  @@index([opportunityId])
}

model LearnerOpportunityMatch {
  id                    String      @id @default(uuid())
  userId                String
  user                  User        @relation("UserOpportunityMatches", fields: [userId], references: [id], onDelete: Cascade)
  opportunityId         String
  opportunity           Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  matchScore            Float
  matchingReasons       Json
  missingRequirements   Json
  recommendedPreparation String
  calculatedAt          DateTime    @default(now())
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@unique([userId, opportunityId])
  @@index([userId])
  @@index([opportunityId])
}

model OpportunityRecommendation {
  id                    String      @id @default(uuid())
  userId                String
  user                  User        @relation("UserOpportunityRecommendations", fields: [userId], references: [id], onDelete: Cascade)
  opportunityId         String
  opportunity           Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  priority              String      @default("MEDIUM")
  status                String      @default("RECOMMENDED")
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([userId])
  @@index([opportunityId])
}

