// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String   @id @default(uuid())
  name                 String
  email                String   @unique
  password             String
  role                 String   @default("student")
  
  parentId             String?
  parent               User?    @relation("UserChildren", fields: [parentId], references: [id])
  children             User[]   @relation("UserChildren")

  phone                String?
  gender               String   @default("")
  dateOfBirth          String?
  batch                String?
  section              String?
  address              String?
  emergencyContact     String?
  department           String?
  specialization       String?
  occupation           String?
  paymentStatus        String   @default("none")
  outstandingBalance   Float    @default(0)

  userCourseProgress   UserCourseProgress[]

  avatar               String   @default("default-avatar.png")
  coverPhoto           String   @default("")
  bio                  String?
  status               String   @default("pending")

  assignedInstructorId String?
  assignedInstructor   User?    @relation("UserInstructor", fields: [assignedInstructorId], references: [id])
  assignedStudents     User[]   @relation("UserInstructor")

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  coursesTaught        Course[]             @relation("CourseInstructor")
  enrollments          Enrollment[]         @relation("EnrollmentStudent")
  settings             UserSetting?
  messagesSent         Message[]            @relation("MessageSender")
  messagesReceived     Message[]            @relation("MessageReceiver")
  progressLogs         ProgressLog[]
  certificates         Certificate[]
  achievements         Achievement?
  activities           Activity[]
  voiceLearningSessions VoiceLearningSession[]
  courseReports        CourseReport[]       @relation("CourseReportInstructor")
  courseReportRecords  CourseReportRecord[] @relation("CourseReportStudent")
  eventsCreated        Event[]              @relation("EventCreator")
  libraryUploads       Library[]            @relation("LibraryUploader")
  notices              Notice[]             @relation("NoticeAuthor")
  resources            Resource[]           @relation("ResourceAddedBy")
  sectionsTaught       Section[]            @relation("SectionInstructor")
  sectionsJoined       Section[]            @relation("SectionStudents")
  
  sponsorships         Sponsorship[]        @relation("StudentSponsorships")
  sponsoredStudents    Sponsorship[]        @relation("SponsorSponsorships")

  // Support and Sponsorship relationships
  supportedBySponsors  StudentSupport[]     @relation("SupportedBy")
  sponsorTransactions  SponsorshipTransaction[] @relation("StudentTransactions")
  notifications        Notification[]       @relation("UserNotifications")

  adminGroups          MessageGroup[]       @relation("GroupAdmin")
  memberGroups         MessageGroup[]       @relation("GroupMembers")

  connectionRequestsSent     ConnectionRequest[] @relation("Requester")
  connectionRequestsReceived ConnectionRequest[] @relation("Target")

  liveClassesTaught    LiveClass[]           @relation("LiveClassInstructor")
  liveClassAttendances LiveClassAttendance[] @relation("LiveClassAttendee")
  recordedClasses      RecordedClass[]       @relation("RecordedClassInstructor")
  
  recordingPermissions RecordingPermission[] @relation("RecordingPermissions")
  grantedPermissions   RecordingPermission[] @relation("GrantedPermissions")
  watchHistory         WatchHistory[]        @relation("WatchHistoryStudent")
  
  learnerGroups        LearnerGroup[]        @relation("GroupStudents")
  studyPlans           StudyPlan[]
  flashcardDecks       FlashcardDeck[]

  learningProfile      LearnerProfile?
  learningHistory      LearningHistoryEvent[]
  learningSkills       LearnerSkill[] @relation("UserLearningSkills")
  learningWeaknesses   LearnerWeakness[] @relation("UserLearningWeaknesses")
  learningSnapshots    LearningProgressSnapshot[]
  mentorConversations  MentorConversation[]
  mentorInteractions    MentorInteraction[]
  courseIntelligenceDocuments CourseIntelligenceDocument[]

  // Intelligence Core relations
  recommendations      RecommendationResult[]
  quizAttempts         QuizAttempt[]
  learningSessions     LearningSession[]
  analyticsReport      LearnerAnalyticsReport?
  learningEvents       LearningEvent[]       @relation("UserLearningEvents")
  courseLearnerProfiles CourseLearnerProfile[] @relation("UserCourseLearnerProfiles")
  mentorSessions       MentorSession[]       @relation("UserMentorSessions")
  learnerRecommendations LearnerRecommendation[] @relation("UserLearnerRecommendations")
  adaptivePlans        AdaptiveLearningPlan[]  @relation("UserAdaptivePlans")
  adaptiveRecommendations AdaptiveRecommendation[] @relation("UserAdaptiveRecommendations")
  milestones           MilestoneProgress[]     @relation("UserMilestones")
  opportunityMatches   LearnerOpportunityMatch[] @relation("UserOpportunityMatches")
  opportunityRecommendations OpportunityRecommendation[] @relation("UserOpportunityRecommendations")
  skillEvidences       SkillEvidence[]       @relation("UserSkillEvidences")
  skillPassport        SkillPassport?        @relation("UserSkillPassport")
  careerTargets        LearnerCareerTarget[] @relation("UserCareerTargets")
  cohortMemberships    CohortMember[]        @relation("UserCohortMemberships")
  understandingAnalyses ConceptUnderstandingAnalysis[] @relation("UserUnderstandingAnalyses")
  practiceSessions     AIPracticeSession[]   @relation("UserPracticeSessions")
  assessmentInsights   AssessmentInsight[]   @relation("UserAssessmentInsights")
  instructorInsights   InstructorInsight[]   @relation("InstructorInsights")
  intelligentNudges    IntelligentNudge[]    @relation("UserIntelligentNudges")
  humanSupportTickets  HumanSupportTicket[]  @relation("UserHumanSupportTickets")
  learningRoadmaps     LearningRoadmap[]     @relation("UserLearningRoadmaps")
  projectSubmissions   ProjectSubmission[]   @relation("UserProjectSubmissions")
  portfolioItems       PortfolioItem[]       @relation("UserPortfolioItems")
  intelligenceFeedbacks IntelligenceFeedback[] @relation("UserIntelligenceFeedbacks")
  instructorInterventions InstructorIntervention[] @relation("UserInstructorInterventions")
  guardianLinks        GuardianStudent[]     @relation("GuardianStudentGuardian")
  studentLinks         GuardianStudent[]     @relation("GuardianStudentStudent")
  guardianNotifications GuardianNotification[] @relation("UserGuardianNotifications")
  conceptMasteries     LearnerConceptMastery[] @relation("UserConceptMasteries")
  conceptPracticeSessions PracticeSession[]   @relation("UserConceptPracticeSessions")
  studentLearningPlans StudentLearningPlan[]  @relation("UserLearningPlans")

  // Phase 12 — Career Intelligence relations
  careerInterests      LearnerCareerInterest[] @relation("UserCareerInterests")
  careerGoals          CareerGoal[]            @relation("UserCareerGoals")

  // Phase 13 — Real-World Experience, Project & Portfolio Intelligence relations
  projectEvidences     ProjectEvidence[]       @relation("UserProjectEvidences")

  // Phase 14 — Human, Mentorship & Collaborative Intelligence relations
  mentorProfile        MentorProfile?
  peerDiscoverability  PeerDiscoverability?
  relationshipsSent    UserRelationship[]      @relation("RelationshipRequester")
  relationshipsReceived UserRelationship[]     @relation("RelationshipTarget")
  communityMemberships CommunityMember[]       @relation("UserCommunityMemberships")
  createdCommunities   Community[]             @relation("UserCreatedCommunities")
  blocksAndReportsSent UserBlockReport[]       @relation("UserBlockReporter")
  blocksAndReportsReceived UserBlockReport[]   @relation("UserBlockTarget")

  // Phase 15 — Global Opportunity & Ecosystem Intelligence relations
  opportunityApplications OpportunityApplication[] @relation("UserOpportunityApplications")
  studentConsents         StudentConsent[]         @relation("UserStudentConsents")
  opportunityInteractions OpportunityInteraction[] @relation("UserOpportunityInteractions")

  // Phase 17 — Product Experience Audit relations
  productExperienceEvents ProductExperienceEvent[] @relation("UserProductExperienceEvents")
  recommendationFeedbacks RecommendationFeedback[] @relation("UserRecommendationFeedbacks")
  aiMentorFeedbacks       AIMentorFeedback[]       @relation("UserAIMentorFeedbacks")

  // Phase 18 — Real-World Pilot & Learner Validation relations
  pilotParticipations     PilotParticipant[]       @relation("UserPilotParticipations")
  pilotFeedbacks          PilotFeedback[]          @relation("UserPilotFeedbacks")

  // Phase 19 — AI Quality, Safety & Evaluation relations
  aiInteractions          AIInteraction[]          @relation("UserAIInteractions")
  aiQualityFeedbacks      AIFeedback[]             @relation("UserAIFeedbacks")
}

model LearnerProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  academicLevel         String   @default("Intermediate")
  interests             Json?
  learningGoals         Json?
  strengths             Json?
  weaknesses            Json?
  studyHabits           Json?
  learningBehavior      Json?
  completedCourses      Int      @default(0)
  completedLessons      Int      @default(0)
  totalSkills           Int      @default(0)
  quizAverage           Float    @default(0)
  studyConsistencyScore Float    @default(0)
  weeklyStudyHours      Float    @default(0)
  currentFocus          String?
  preferredLearningStyle String   @default("visual")
  currentSkillState     Json?
  overallLearningStatus String   @default("ON_TRACK")
  lastActiveAt          DateTime @default(now())
  confidenceScore       Float    @default(0)
  aiReadinessScore      Float    @default(0)

  // Explicit Intelligence Engine Metrics & Explainability
  engagementScore        Float    @default(0)
  consistencyScore       Float    @default(0)
  learningMomentum       Float    @default(0)
  riskLevel              String   @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  riskReasons            Json?    // Array of explainable risk indicators
  momentumReasons        Json?    // Array of explainable momentum factors
  recommendedNextAction  String?  
  recommendationRationale Json?   // Structured justification for action

  summary               String?
  lastUpdatedAt         DateTime @updatedAt
  createdAt             DateTime @default(now())

  skills                LearnerSkill[]
  weaknessEntries       LearnerWeakness[]
  historyEvents         LearningHistoryEvent[]
  progressSnapshots     LearningProgressSnapshot[]

  // Relational Intelligence Arrays
  goals                 LearnerGoal[]
  learnerInterests      LearnerInterest[]
  insights              LearningInsight[]

  @@index([userId])
}

model LearnerSkill {
  id                  String   @id @default(uuid())
  userId              String?
  user                User?    @relation("UserLearningSkills", fields: [userId], references: [id], onDelete: SetNull)
  profileId           String
  profile             LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name                String
  category            String?
  proficiencyLevel    String   @default("beginner") // beginner, intermediate, advanced, master
  masteryScore        Float    @default(0)
  confidenceScore     Float    @default(0)
  evidenceCount       Int      @default(0)
  masteryState        String   @default("learning") // learning, practicing, mastered
  lastPracticedAt     DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  evidences           SkillEvidence[]

  @@unique([profileId, name])
  @@index([profileId])
}

model LearnerGoal {
  id           String         @id @default(uuid())
  profileId    String
  profile      LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  goalText     String
  category     String?        // career, academic, personal, skill
  targetDate   DateTime?
  status       String         @default("active") // active, achieved, archived
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  roadmaps     LearningRoadmap[]

  @@index([profileId])
}

model LearnerInterest {
  id           String         @id @default(uuid())
  profileId    String
  profile      LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  topic        String
  category     String?
  source       String         @default("inferred") // explicit, inferred
  weight       Float          @default(1.0)
  createdAt    DateTime       @default(now())

  @@index([profileId])
}

model SkillCatalog {
  id           String         @id @default(uuid())
  name         String         @unique
  category     String?
  description  String?
  createdAt    DateTime       @default(now())
}

model LearningInsight {
  id           String         @id @default(uuid())
  profileId    String
  profile      LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type         String         // strength, weakness, risk, trend, recommendation
  title        String
  description  String
  evidenceData Json?
  impact       String         @default("medium") // low, medium, high
  createdAt    DateTime       @default(now())

  @@index([profileId])
  @@index([type])
}

model LearnerWeakness {
  id                  String   @id @default(uuid())
  userId              String?
  user                User?    @relation("UserLearningWeaknesses", fields: [userId], references: [id], onDelete: SetNull)
  profileId           String
  profile             LearnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  topic               String
  category            String?
  severity            String   @default("medium")
  impactScore         Float    @default(0)
  improvementPlan     String?
  lastObservedAt      DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([profileId, topic])
  @@index([profileId])
}

model LearningHistoryEvent {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId           String?
  profile             LearnerProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  eventType           String
  title               String
  description         String?
  courseId            String?
  lessonId            String?
  score               Float?
  durationMinutes     Int      @default(0)
  metadata            Json?
  occurredAt          DateTime @default(now())
  createdAt           DateTime @default(now())

  @@index([userId])
  @@index([profileId])
  @@index([eventType])
}

model LearningProgressSnapshot {
  id                    String   @id @default(uuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId             String?
  profile               LearnerProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  overallProgress       Float    @default(0)
  weeklyProgress        Float    @default(0)
  completedCourses      Int      @default(0)
  completedLessons      Int      @default(0)
  quizAverage           Float    @default(0)
  studyStreak           Int      @default(0)
  weeklyStudyHours      Float    @default(0)
  focusScore            Float    @default(0)
  confidenceScore       Float    @default(0)
  generatedAt           DateTime @default(now())

  @@index([userId])
  @@index([profileId])
}

model MentorConversation {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String?
  contextCourseId   String?
  contextLessonId   String?
  topic             String?
  summary           String?
  messageCount      Int      @default(0)
  lastMessageAt     DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  messages          MentorMessage[]

  @@index([userId])
}

model MentorMessage {
  id                String   @id @default(uuid())
  conversationId     String
  conversation      MentorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role              String
  content           String
  inputType         String   @default("TEXT") // TEXT, VOICE
  outputType        String   @default("TEXT") // TEXT, VOICE
  courseId          String?
  sectionId         String?
  lessonId          String?
  responseId        String?
  intentType        String?  // EXPLAIN_CONCEPT | SIMPLIFY | GIVE_EXAMPLE | STEP_BY_STEP_GUIDANCE | REVIEW_TOPIC | PRACTICE_REQUEST | WHAT_SHOULD_I_DO_NEXT | GENERAL_EDUCATIONAL | UNKNOWN
  groundingStatus   String?  // COURSE_GROUNDED | EDOT_KNOWLEDGE_GROUNDED | GENERAL_EDUCATIONAL | LIMITED_CONTEXT
  suggestedActions  Json?
  sources           Json?
  createdAt         DateTime @default(now())

  @@index([conversationId])
  @@index([responseId])
}

model VoiceLearningSession {
  id                    String   @id @default(uuid())
  learnerId             String
  user                  User     @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  conversationId        String?
  courseId              String?
  sectionId             String?
  lessonId              String?
  mode                  String   @default("EXPLAIN") // EXPLAIN, SOCRATIC, PRACTICE, QUIZ, STUDY, EXAM_PREPARATION, PROJECT_COACH, DEBUG_UNDERSTANDING, MOTIVATION
  status                String   @default("INITIALIZING") // INITIALIZING, ACTIVE, PROCESSING, AI_SPEAKING, LEARNER_SPEAKING, PAUSED, ENDED, FAILED
  voiceStyle            String   @default("Friendly")
  explanationStyle      String   @default("Normal")
  speakingSpeed         String   @default("Normal")
  speechLanguage        String   @default("en-US")
  totalSpeakingDuration Int      @default(0) // seconds
  totalListeningDuration Int     @default(0) // seconds
  startedAt             DateTime @default(now())
  lastActivityAt        DateTime @default(now())
  endedAt               DateTime?

  @@index([learnerId])
  @@index([conversationId])
  @@index([status])
}

model ConversationSummary {
  id                  String   @id @default(uuid())
  conversationId      String
  summaryText         String
  keyTakeaways        Json?
  unresolvedQuestions Json?
  turnRangeStart      Int      @default(0)
  turnRangeEnd        Int      @default(0)
  createdAt           DateTime @default(now())

  @@index([conversationId])
}

model ConversationLearningState {
  id                        String   @id @default(uuid())
  conversationId            String   @unique
  currentTopic              String?
  currentConcept            String?
  currentSkill              String?
  learnerUnderstandingLevel String   @default("developing") // beginner, developing, proficient, advanced
  detectedMisconceptions   Json?
  unresolvedQuestions       Json?
  currentLearningGoal       String?
  recommendedNextAction     String?
  updatedAt                 DateTime @updatedAt

  @@index([conversationId])
}

model MentorInteraction {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interactionType   String
  topic             String?
  courseId          String?
  lessonId          String?
  requestPreview    String?
  responsePreview   String?
  confidence        Float    @default(0)
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([interactionType])
}

model UserCourseProgress {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  courseId         String
  course           Course   @relation(fields: [courseId], references: [id])
  enrolledAt       DateTime @default(now())
  status           String   @default("pending")
  progress         Float    @default(0)
  completedLessons Json?
  watchedVideos    Json?
  passedQuizzes    Json?
  passedFinalExam  Boolean  @default(false)
  score            Float    @default(0)
  completed        Boolean  @default(false)
  
  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model Course {
  id                 String   @id @default(uuid())
  title              String
  slug               String   @unique
  description        String
  instructorId       String
  instructor         User     @relation("CourseInstructor", fields: [instructorId], references: [id])
  mainCategory       String
  subCategory        String
  level              String   @default("Beginner")
  duration           Float
  thumbnail          String   @default("default-course.jpg")
  imageUrl           String?
  videoUrl           String?
  price              Float    @default(0)
  rating             Float    @default(4.5)
  totalStudents      Int      @default(0)
  
  materials          Json?
  lessonsEmbedded    Json?
  lessons            Lesson[] @relation("CourseLessons")
  liveClasses        LiveClass[]
  recordedClasses    RecordedClass[]
  
  requirements       String[]
  whatYouWillLearn   String[]
  isExamRequired     Boolean  @default(false)
  finalExam          Json?
  isPublished        Boolean  @default(false)
  status             String   @default("draft")
  tags               String[]
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sections           Section[]
  enrollments        Enrollment[]
  progressLogs       ProgressLog[]
  certificates       Certificate[]
  userProgress       UserCourseProgress[]
  courseLearnerProfiles CourseLearnerProfile[] @relation("CourseLearnerProfiles")
  libraryItems       Library[]
  courseReports      CourseReport[]
  sponsorships       Sponsorship[]        @relation("SponsorshipCourses")
  intelligenceDocuments CourseIntelligenceDocument[]
  snapshots          CourseIntelligenceSnapshot[] @relation("CourseSnapshots")
  skillMappings      CourseSkillMapping[]
  instructorInterventions InstructorIntervention[] @relation("CourseInstructorInterventions")
  knowledgeContentMappings KnowledgeContentMapping[]
  knowledgeChunks    KnowledgeChunk[]
  practiceSessions   PracticeSession[]       @relation("CoursePracticeSessions")
  questionIntelligence QuestionIntelligence[] @relation("CourseQuestionIntelligence")
  studentLearningPlans StudentLearningPlan[]  @relation("CourseLearningPlans")
  projects             Project[]              @relation("CourseProjects")
}

model Lesson {
  id               String   @id @default(uuid())
  title            String
  description      String
  videoUrl         String
  duration         Float
  courseId         String
  course           Course   @relation("CourseLessons", fields: [courseId], references: [id])
  order            Int
  resources        Json?
  quiz             Json?
  readingMaterials String   @default("")
  phase            String?  // Allows grouping lessons by phase/module
  isPreview        Boolean  @default(false)
  
  materials        Material[] @relation("LessonMaterials")
  quizzes          Quiz[]     @relation("LessonQuizzes")
  intelligenceDocuments CourseIntelligenceDocument[]
  knowledgeContentMappings KnowledgeContentMapping[]
  knowledgeChunks    KnowledgeChunk[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([courseId, order])
}

model CourseIntelligenceDocument {
  id                String   @id @default(uuid())
  courseId          String
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId          String?
  lesson            Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  createdByUserId   String?
  createdByUser     User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  title             String
  contentType       String   @default("lesson")
  contentText       String
  summary           String?
  keyConcepts       Json?
  flashcards        Json?
  quizQuestions     Json?
  learningPath      Json?
  chunkCount        Int      @default(0)
  status            String   @default("processing")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  chunks            CourseIntelligenceChunk[]

  @@index([courseId])
  @@index([lessonId])
}

model CourseIntelligenceChunk {
  id                String   @id @default(uuid())
  documentId        String
  document          CourseIntelligenceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex        Int
  content           String
  metadata          Json?
  createdAt         DateTime @default(now())

  @@index([documentId])
}

model Section {
  id             String   @id @default(uuid())
  name           String
  sectionCode    String?  @unique
  courseId       String
  course         Course   @relation(fields: [courseId], references: [id])
  instructorId   String?
  instructor     User?    @relation("SectionInstructor", fields: [instructorId], references: [id])
  students       User[]   @relation("SectionStudents")
  
  capacity       Int      @default(30)
  academicYear   String   @default("2026-2027")
  semester       String   @default("1")
  status         String   @default("active")
  
  scheduleDays   String[]
  scheduleTime   String?
  
  groupId        String?
  group          LearnerGroup? @relation(fields: [groupId], references: [id])
  batch          String?
  liveClasses    LiveClass[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model LearnerGroup {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  students    User[]   @relation("GroupStudents")
  sections    Section[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Enrollment {
  id             String   @id @default(uuid())
  studentId      String
  student        User     @relation("EnrollmentStudent", fields: [studentId], references: [id])
  courseId       String
  course         Course   @relation(fields: [courseId], references: [id])
  sectionId      String?
  status         String   @default("pending")
  reason         String   @default("")
  requestedAt    DateTime @default(now())
  approvedAt     DateTime?
  approvedBy     String?
  rejectionReason String   @default("")
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  courseLearnerProfiles CourseLearnerProfile[] @relation("EnrollmentCourseLearnerProfiles")

  @@unique([studentId, courseId])
}

model ProgressLog {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  courseId          String
  course            Course   @relation(fields: [courseId], references: [id])
  lessonId          String
  videoSegments     Int[]
  isVideoComplete   Boolean  @default(false)
  examScores        Json?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, lessonId])
}

model UserSetting {
  id                        String   @id @default(uuid())
  userId                    String   @unique
  user                      User     @relation(fields: [userId], references: [id])
  
  timezone                  String   @default("(GMT+03:00) East Africa Time")
  notifySystem              Boolean  @default(true)
  notifyMessages            Boolean  @default(true)
  notifyDigest              Boolean  @default(false)
  
  shareMilestones           Boolean  @default(true)
  shareGrades               Boolean  @default(true)
  privateMode               Boolean  @default(false)
  
  billingMethod             String   @default("unlinked")
  alertGradeBelow           Float    @default(70)
  alertAbsenceCount         Int      @default(3)
  
  consultationHours         String   @default("Mon-Wed 3PM-5PM")
  courseVisibility          String   @default("public")
  autoTags                  Boolean  @default(true)
  autoGrade                 Boolean  @default(false)
  
  primaryColor              String   @default("#0B0E14")
  feePercentage             Float    @default(10)
  autoInterventionTriggers  Boolean  @default(true)
  apiKey                    String   @default("")
  blockedUsers              String[] // Telegram Block System
  
  weeklyStudyGoal           Float    @default(10)

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model Attendance {
  id             String   @id @default(uuid())
  courseId       String
  section        String
  date           DateTime
